{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibrush.dev/schemas/media-test/fixture-seed-v1.schema.json",
  "title": "Deterministic media-test fixture seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "seedId", "seedHex", "purpose"],
  "properties": {
    "$schema": { "const": "./schemas/fixture-seed-v1.schema.json" },
    "schemaVersion": { "const": "media-test/fixture-seed@1" },
    "seedId": { "type": "string", "minLength": 1 },
    "seedHex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "purpose": { "type": "string", "minLength": 1 }
  }
}
