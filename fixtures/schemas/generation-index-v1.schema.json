{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibrush.dev/schemas/media-test/generation-index-v1.schema.json",
  "title": "Atomic immutable fixture generation index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "generationId", "createdAtIso", "publicationScope", "entries", "availability"],
  "properties": {
    "schema": { "const": "media-test/fixture-generation-index@1" },
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "generationId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "createdAtIso": { "type": "string", "format": "date-time" },
    "publicationScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "complete-corpus" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "assetIds"],
          "properties": {
            "mode": { "const": "selected-assets" },
            "assetIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" }
            }
          }
        }
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logicalPath", "generationPath", "artifactKind", "sha256", "sizeBytes", "sourceMediaSha256", "provenanceSha256", "audit"],
        "properties": {
          "logicalPath": { "type": "string", "minLength": 1 },
          "generationPath": { "type": "string", "minLength": 1 },
          "artifactKind": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "sourceMediaSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "provenanceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "audit": {
            "type": "object",
            "additionalProperties": false,
            "required": ["recipe", "bakerVersion", "outputArtifactSha256"],
            "properties": {
              "recipe": { "type": "string", "minLength": 1 },
              "bakerVersion": { "type": "string", "minLength": 1 },
              "outputArtifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "availability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["logicalPath", "state", "reasonCode"],
        "properties": {
          "logicalPath": { "type": "string", "minLength": 1 },
          "state": { "enum": ["absent-expected", "pending", "producer-failed"] },
          "reasonCode": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
