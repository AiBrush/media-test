{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibrush.dev/schemas/media-test/golden-artifact-v1.schema.json",
  "title": "Versioned attributable golden evidence",
  "type": "object",
  "required": ["schema", "schemaVersion", "artifactKind", "assetId", "sourceMedia", "availability", "provenance", "payload"],
  "properties": {
    "schema": { "const": "media-test/golden-artifact@1" },
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "artifactKind": { "enum": ["metadata", "packets", "frames", "ssim", "keys", "segments", "availability"] },
    "assetId": { "type": "string", "minLength": 1 },
    "sourceMedia": { "$ref": "#/$defs/subject" },
    "availability": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": { "enum": ["ready", "absent-expected", "pending", "producer-failed"] },
        "reasonCode": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "payload": {}
  },
  "additionalProperties": true,
  "$defs": {
    "subject": {
      "type": "object",
      "required": ["sha256", "sizeBytes"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["schema", "schemaVersion", "artifactKind", "assetId", "sourceMedia", "buildDefinition", "runDetails", "outputArtifact"],
      "properties": {
        "schema": { "const": "media-test/golden-provenance@1" },
        "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
        "artifactKind": { "type": "string" },
        "assetId": { "type": "string", "minLength": 1 },
        "sourceMedia": { "$ref": "#/$defs/subject" },
        "buildDefinition": {
          "type": "object",
          "required": ["recipe", "normalizedArguments", "normalizedArgumentsSha256", "dependencies"],
          "properties": {
            "recipe": { "type": "string", "minLength": 1 },
            "normalizedArguments": {},
            "normalizedArgumentsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["logicalId", "sha256", "sizeBytes"],
                "properties": {
                  "logicalId": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "sizeBytes": { "type": "integer", "minimum": 0 }
                }
              }
            }
          },
          "additionalProperties": false
        },
        "runDetails": {
          "type": "object",
          "required": ["baker", "perimeter", "startedAtIso", "finishedAtIso", "timeMode", "browserQualified"],
          "properties": {
            "baker": { "type": "string", "minLength": 1 },
            "perimeter": { "$ref": "#/$defs/perimeter" },
            "startedAtIso": { "type": "string", "format": "date-time" },
            "finishedAtIso": { "type": "string", "format": "date-time" },
            "timeMode": { "const": "source-date-epoch" },
            "browserQualified": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "outputArtifact": { "$ref": "#/$defs/outputSubject" }
      },
      "additionalProperties": false
    },
    "outputSubject": {
      "allOf": [{ "$ref": "#/$defs/subject" }],
      "type": "object",
      "required": ["digestScope", "sha256", "sizeBytes"],
      "properties": {
        "digestScope": { "const": "canonical-payload" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "toolRecord": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": { "enum": ["present", "absent", "not-applicable"] },
        "executable": { "type": "string", "minLength": 1 },
        "versionOutput": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "exitStatus": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "perimeter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "tools", "platform", "environment", "declaredLock"],
      "properties": {
        "schemaVersion": { "const": "tool-perimeter@1" },
        "tools": {
          "type": "object",
          "required": ["bun", "ffmpeg", "ffprobe", "bento4", "bento4Hls", "shakaPackager", "playwright", "browser"],
          "properties": {
            "bun": { "$ref": "#/$defs/toolRecord" },
            "ffmpeg": { "$ref": "#/$defs/toolRecord" },
            "ffprobe": { "$ref": "#/$defs/toolRecord" },
            "bento4": { "$ref": "#/$defs/toolRecord" },
            "bento4Hls": { "$ref": "#/$defs/toolRecord" },
            "shakaPackager": { "$ref": "#/$defs/toolRecord" },
            "playwright": { "$ref": "#/$defs/toolRecord" },
            "browser": { "$ref": "#/$defs/toolRecord" }
          },
          "additionalProperties": false
        },
        "platform": {
          "type": "object",
          "required": ["os", "release", "arch", "locale", "timezone"],
          "properties": {
            "os": { "type": "string", "minLength": 1 },
            "release": { "type": "string", "minLength": 1 },
            "arch": { "type": "string", "minLength": 1 },
            "locale": { "type": "string", "minLength": 1 },
            "timezone": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "required": ["SOURCE_DATE_EPOCH", "LANG", "LC_ALL", "TZ", "BRAVE_PATH", "FFMPEG_PATH", "FFPROBE_PATH"],
          "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "declaredLock": {
          "type": "object",
          "required": ["sha256", "sourceDateEpoch", "locale", "timezone", "required", "optional"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "sourceDateEpoch": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^[0-9]+$" }] },
            "locale": { "type": "string", "minLength": 1 },
            "timezone": { "type": "string", "minLength": 1 },
            "required": {
              "type": "object",
              "required": ["bun", "ffmpeg", "ffprobe"],
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "optional": { "type": "object" }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
