{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibrush.dev/schemas/media-test/toolchain-perimeter-v1.schema.json",
  "title": "Pinned fixture tool/environment perimeter",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "sourceDateEpoch", "locale", "timezone", "required", "optional", "environmentVariables"],
  "properties": {
    "$schema": { "const": "./schemas/toolchain-perimeter-v1.schema.json" },
    "schemaVersion": { "const": "media-test/toolchain-perimeter@1" },
    "sourceDateEpoch": { "type": "integer", "minimum": 0 },
    "locale": { "type": "string", "minLength": 1 },
    "timezone": { "type": "string", "minLength": 1 },
    "required": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bun", "ffmpeg", "ffprobe"],
      "properties": {
        "bun": { "type": "string", "minLength": 1 },
        "ffmpeg": { "type": "string", "minLength": 1 },
        "ffprobe": { "type": "string", "minLength": 1 }
      }
    },
    "optional": { "type": "object" },
    "environmentVariables": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
